{
  "name": "onetag-monolith",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "description": "OneTag — social media app built with React Native, Expo, and Supabase",
  "license": "Apache-2.0",
  "author": "OneTag",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && sh scripts/check-no-raw-hex.sh",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:status": "npx supabase status",
    "db:reset": "npx supabase db reset",
    "db:diff": "npx supabase db diff -f",
    "db:test": "npx supabase test db",
    "db:seed": "node scripts/seed.cjs --local",
    "db:seed:hosted": "node scripts/seed.cjs --hosted",
    "check:api": "jest -c jest.api.config.js",
    "publish:preview": "npx eas-cli@latest update --branch preview --environment preview"
  },
  "dependencies": {
    "@dev-plugins/react-query": "^0.4.0",
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/dom-webview": "~58.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@supabase/supabase-js": "^2.43.4",
    "@tanstack/query-async-storage-persister": "^5.103.2",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-query-persist-client": "^5.103.2",
    "babel-preset-expo": "~58.0.20",
    "date-fns": "^3.6.0",
    "expo": "~58.0.19",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-media-library": "~58.0.12",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "nativewind": "^4.1.23",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-css-interop": "^0.2.7",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "jsqr": "^1.4.0",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  },
  "private": true
}
